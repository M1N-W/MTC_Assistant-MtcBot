# Copy this file to .env and fill in real values.
# Never commit .env, Firebase private keys, or real API tokens.

# Flask / runtime
PORT=5000
FLASK_DEBUG=false
DEBUG=false

# LINE Messaging API v3
CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
CHANNEL_SECRET=your_line_channel_secret

# Google Gemini dual-model setup
GEMINI_API_KEY_PRIMARY=your_primary_gemini_api_key
GEMINI_API_KEY_SECONDARY=your_secondary_gemini_api_key
GEMINI_MODEL_PRIMARY=gemini-2.0-flash
GEMINI_MODEL_SECONDARY=gemini-2.5-flash-preview-04-17

# Firebase Admin SDK credentials
# Recommended for Docker/VPS: use exactly one of these two env vars.
# FIREBASE_CREDENTIALS_JSON should be a single-line raw service account JSON string.
# FIREBASE_CREDENTIALS_BASE64 should be base64-encoded service account JSON.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_BASE64=

# Admin LINE user IDs, comma-separated with no spaces required.
ADMIN_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,Uyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# Rate limiting
RATE_LIMIT_MAX=6
RATE_LIMIT_WINDOW=60

# Optional integrations
YOUTUBE_API_KEY=

# Optional Gunicorn tuning. Keep workers at 1 while state is in process memory.
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_KEEP_ALIVE=5

# Web dashboard
# Use the same MTC_DASHBOARD_API_TOKEN in the Flask bot service and the Next.js dashboard service.
MTC_DASHBOARD_API_TOKEN=replace_with_long_random_token
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000,https://your-dashboard.onrender.com
DASHBOARD_PASSWORD=replace_with_admin_password
DASHBOARD_SESSION_SECRET=replace_with_long_random_session_secret
DASHBOARD_ADMIN_ID=dashboard-admin
DASHBOARD_ADMIN_ROLE=super_admin
# Class-admin principals cannot manage BYOK v1.
DASHBOARD_ALLOWED_CLASS_IDS=mtc13
MTC_BOT_API_BASE_URL=http://localhost:5000
MTC_EXPECTED_CLASS_SIZE=30
PAPER_CO2_GRAMS_PER_SHEET=4.5

# Multi-provider system credentials. Class BYOK credentials fall back to these
# within the configured per-class daily budgets.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AES-256-GCM keyring for encrypted class BYOK credentials.
# JSON object values are base64-encoded 32-byte keys, for example:
# AI_CREDENTIALS_ENCRYPTION_KEYS={"1":"<base64-32-byte-key>"}
AI_CREDENTIALS_ENCRYPTION_KEYS=
AI_CREDENTIALS_CURRENT_KEY_VERSION=1
ALLOW_CLASS_BYOK=true
ALLOW_USER_BYOK=false

# Hidden MTC67 easter egg media.
MTC67_VIDEO_URL=https://example.com/mtc67.mp4
MTC67_PREVIEW_IMAGE_URL=https://example.com/mtc67-preview.jpg
